# =====================================================================
# TrendBot - variaveis de ambiente
# Producao: configure TODAS no painel da Vercel (Settings > Environment
# Variables). Local: copie para .env.local (nunca commite).
# =====================================================================

# --- Binance --------------------------------------------------------
# Chave SEM permissao de saque, so "Enable Spot & Margin Trading", com
# IP allowlist. NUNCA guarde isto no Supabase nem no repositorio.
# So e usada quando bot_config.dry_run = false.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Host das ordens e dos dados de mercado:
#   producao: https://api.binance.com
#   testnet:  https://testnet.binance.vision  (chaves do testnet sao outras)
BINANCE_BASE_URL=https://api.binance.com
# Opcional: host so para klines/exchangeInfo (default = BINANCE_BASE_URL).
# Util no testnet, cujos candles sao ralos: use https://data-api.binance.vision
# BINANCE_MARKET_DATA_URL=

# --- Binance Futuros USDT-M (so se bot_config.market = 'futures') ---
# Por padrao usa as mesmas chaves acima (a chave precisa de "Enable Futures").
# Para separar, defina chaves proprias de futuros:
# BINANCE_FUTURES_API_KEY=
# BINANCE_FUTURES_API_SECRET=
# Host de futuros:
#   producao: https://fapi.binance.com
#   testnet:  https://testnet.binancefuture.com  (chaves do testnet de futuros)
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# --- Supabase -------------------------------------------------------
# Project Settings > API. A service_role ignora RLS: so no servidor.
# NAO use o prefixo NEXT_PUBLIC_ aqui - o browser nunca recebe chave.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Seguranca das rotas --------------------------------------------
# Segredo do Vercel Cron: a Vercel envia "Authorization: Bearer $CRON_SECRET"
# para /api/cron/run. Minimo 16 caracteres. Gere com: openssl rand -hex 32
CRON_SECRET=
# Login do painel (HTTP Basic Auth). Sem senha o painel nao abre.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Dry-run --------------------------------------------------------
# Saldo inicial (USDT) da carteira simulada usada enquanto dry_run = true.
PAPER_INITIAL_USDT=1000

# --- Telegram (opcional) --------------------------------------------
# Notificacoes de entrada, saida, erro e kill switch.
# Crie o bot com @BotFather; descubra o chat id com @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backtest (so local, NAO vai para a Vercel) ---------------------
# Usada apenas por backtest/analyst.py (critica cetica das metricas).
# ANTHROPIC_API_KEY=
